/.bundle/
/log/*
/tmp/*
.env
*.log

# local AI tooling state
.claude-flow/
.claude/
.swarm/
ruvector.db

# Jekyll docs site build output
docs/_site/
docs/.jekyll-cache/
docs/.bundle/
docs/vendor/

# Gemfile.lock is not committed for a library — the gem is resolved against
# whatever the host app already has, and pinning here would only hide drift.
/Gemfile.lock

# `rake build` output
/pkg/
/checksums/

# built gem artifacts (`gem build`) — released to RubyGems, not committed
*.gem

# Secrets. A committed key is a key in public history the moment this repo is
# open, and history is the part you cannot take back — so these are matched
# anywhere, not just at the path the demo happens to use today.
**/config/master.key
**/config/credentials/*.key
demo/config/credentials.yml.enc
*.pem
*.p12
.env
.env.*

# demo app runtime artifacts
demo/log/*
demo/tmp/*
demo/storage/*
demo/db/*.sqlite3
demo/db/*.sqlite3-*
demo/.bundle/
!demo/log/.keep
!demo/tmp/.keep
!demo/storage/.keep

# Security audit reports — findings on a PUBLIC repo. Keep local until fixed.
SECURITY-AUDIT-*.md
