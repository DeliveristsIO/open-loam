/.bundle/
/log/*
/tmp/*
.env
*.log

# local AI tooling state
.claude-flow/
.claude/
.swarm/
ruvector.db

# Jekyll docs site build output
docs/_site/
docs/.jekyll-cache/
docs/.bundle/
docs/vendor/

# Gemfile.lock is not committed for a library — the gem is resolved against
# whatever the host app already has, and pinning here would only hide drift.
/Gemfile.lock

# `rake build` output
/pkg/
/checksums/

# built gem artifacts (`gem build`) — released to RubyGems, not committed
*.gem

# demo app secrets — the demo needs no credentials, and a committed master.key
# is a key in public history the moment this repo is open.
demo/config/master.key
demo/config/credentials.yml.enc

# demo app runtime artifacts
demo/log/*
demo/tmp/*
demo/storage/*
demo/db/*.sqlite3
demo/db/*.sqlite3-*
demo/.bundle/
!demo/log/.keep
!demo/tmp/.keep
!demo/storage/.keep
