<h1>Deleted <%= plural_name.humanize.downcase %></h1>

<p><%%= link_to "← Back to <%= plural_name.humanize.downcase %>", [:admin, <%= class_name %>] %></p>

<%%# No Show/Edit here: these rows are hidden by the default scope, so a plain
    find would 404. The one action a deleted record offers is Restore. %>
<table>
  <thead>
    <tr>
      <th>ID</th>
<% attributes.each do |attribute| -%>
      <th><%= attribute.name.humanize %></th>
<% end -%>
      <th>Deleted at</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <%% @records.each do |record| %>
      <tr>
        <td><%%= record.id %></td>
<% attributes.each do |attribute| -%>
        <td><%%= record.<%= attribute.name %> %></td>
<% end -%>
        <td><%%= record.deleted_at %></td>
        <td><%%= button_to "Restore", [:restore, :admin, record], method: :patch %></td>
      </tr>
    <%% end %>
  </tbody>
</table>

<%%# Page links carry nothing but the page: the recycle bin has no filter box. %>
<p>
  <%% if @page > 1 %>
    <%%= link_to "← Previous", polymorphic_path([:deleted, :admin, <%= class_name %>], page: @page - 1) %>
  <%% end %>
  Page <%%= @page %>
  <%% if @has_next %>
    <%%= link_to "Next →", polymorphic_path([:deleted, :admin, <%= class_name %>], page: @page + 1) %>
  <%% end %>
</p>
