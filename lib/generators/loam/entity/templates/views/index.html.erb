<h1><%= plural_name.humanize %></h1>

<p><%%= link_to "New <%= human_name.downcase %>", new_polymorphic_path([:admin, <%= class_name %>]) %></p>

<table>
  <thead>
    <tr>
      <th>ID</th>
<% attributes.each do |attribute| -%>
      <th><%= attribute.name.humanize %></th>
<% end -%>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <%% @records.each do |record| %>
      <tr>
        <td><%%= record.id %></td>
<% attributes.each do |attribute| -%>
        <td><%%= record.<%= attribute.name %> %></td>
<% end -%>
        <td>
          <%%= link_to "Show", [:admin, record] %>
          <%%= link_to "Edit", edit_polymorphic_path([:admin, record]) %>
        </td>
      </tr>
    <%% end %>
  </tbody>
</table>
