<h1><%= plural_name.humanize %></h1>

<p>
  <%%= link_to "New <%= human_name.downcase %>", new_polymorphic_path([:admin, <%= class_name %>]) %>
  <%%= link_to "Deleted <%= plural_name.humanize.downcase %>", polymorphic_path([:deleted, :admin, <%= class_name %>]) %>
  <%% if current_role == :manager %>
    <%%= link_to "Export CSV", url_for(action: :export, q: params[:q], perspective_id: params[:perspective_id]) %>
    <%%= link_to "Import CSV", new_admin_import_path(entity_type: "<%= class_name %>") %>
  <%% end %>
</p>

<%%# Saved views (Loam::Perspectives): pick one to apply, or save the current one. %>
<%% if @perspectives.any? %>
  <%%= form_with url: [:admin, <%= class_name %>], method: :get do %>
    <%%= select_tag :perspective_id,
          options_for_select([["All <%= plural_name.humanize.downcase %> (no saved view)", "none"]] + @perspectives.map { |p| [p.name, p.id] }, @perspective&.id),
          onchange: "this.form.submit()" %>
    <%%= link_to "Manage views", admin_perspectives_path(entity_type: "<%= class_name %>") %>
  <%% end %>
<%% else %>
  <p><%%= link_to "Manage saved views", admin_perspectives_path(entity_type: "<%= class_name %>") %></p>
<%% end %>

<%%= form_with url: admin_perspectives_path, method: :post do %>
  <%%= hidden_field_tag :entity_type, "<%= class_name %>" %>
  <%%= hidden_field_tag :q, params[:q] %>
  <%%= text_field_tag :name, nil, placeholder: "Name this view" %>
  <%%= submit_tag "Save current view" %>
<%% end %>
<% if searchable_attributes.any? -%>

<%%= form_with url: [:admin, <%= class_name %>], method: :get do |f| %>
  <%%= text_field_tag :q, params[:q], placeholder: "Filter <%= plural_name.humanize.downcase %>" %>
  <%%= f.submit "Filter" %>
<%% end %>
<% end -%>

<%%# Bulk actions on selected rows (Loam::Bulk). Zero selection = no-op; each
    action is policy-checked per record server-side. %>
<%%= form_with url: url_for(action: :bulk), method: :post do %>
  <p>
    <%%= select_tag :bulk_action, options_for_select([["Delete selected", "soft_delete"], ["Set field on selected", "set_field"], ["Export selected", "export"]]) %>
    <%%= select_tag :field, options_for_select(%i[<%= field_names.join(" ") %>]) %>
    <%%= text_field_tag :value, nil, placeholder: "new value (for Set field)" %>
    <%%= submit_tag "Apply to selected", data: { turbo_confirm: "Apply to the selected rows?" } %>
  </p>

  <table>
    <thead>
      <tr>
        <th><input type="checkbox" onclick="document.querySelectorAll('.bulk-select').forEach(function(c){c.checked=this.checked}.bind(this))"></th>
        <th>ID</th>
<% attributes.each do |attribute| -%>
        <th><%= attribute.name.humanize %></th>
<% end -%>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <%% @records.each do |record| %>
        <tr>
          <td><%%= check_box_tag "ids[]", record.id, false, class: "bulk-select" %></td>
          <td><%%= record.id %></td>
<% attributes.each do |attribute| -%>
          <td><%%= record.<%= attribute.name %> %></td>
<% end -%>
          <td>
            <%%= link_to "Show", [:admin, record] %>
            <%%= link_to "Edit", edit_polymorphic_path([:admin, record]) %>
          </td>
        </tr>
      <%% end %>
    </tbody>
  </table>
<%% end %>

<%%# Page links carry the filter, or page 2 would quietly drop it. %>
<p>
  <%% if @page > 1 %>
    <%%= link_to "← Previous", polymorphic_path([:admin, <%= class_name %>], page: @page - 1, q: params[:q]) %>
  <%% end %>
  Page <%%= @page %>
  <%% if @has_next %>
    <%%= link_to "Next →", polymorphic_path([:admin, <%= class_name %>], page: @page + 1, q: params[:q]) %>
  <%% end %>
</p>
