diff --git a/app/jobs/customer_export_job.rb b/app/jobs/customer_export_job.rb
new file mode 100644
index 0000000..a5a5d2e
--- /dev/null
+++ b/app/jobs/customer_export_job.rb
@@ -0,0 +1,45 @@
+# Builds the customers CSV in the background, advancing a Loam::ProgressJob so the
+# manager watches it under Tasks (L-915) — the same shape as ImportJob, which is
+# the app's other long-running bulk operation. Carries tenant + actor explicitly,
+# like every Loam job: a job runs with no request context, so the tenant it must
+# read has to be re-established rather than inherited.
+#
+# The finished file is parked on the ProgressJob's `result` (the column exists for
+# exactly this — "structured result for a finished job"), so downloading it later
+# is a tenant-scoped row lookup and never an unguarded blob URL.
+class CustomerExportJob < ApplicationJob
+  queue_as :default
+
+  # Marks the ProgressJob rows this feature owns, so the customers page can list
+  # its own exports without picking up imports or reindexes.
+  KEY = "export:Customer".freeze
+
+  def perform(status:, tenant_id:, actor_id:)
+    tenant = Loam::Tenant.find(tenant_id)
+    actor = User.find_by(id: actor_id)
+
+    Loam.as_tenant(tenant, actor: actor) do
+      # Already tenant-scoped by Loam::TenantRecord; by_status narrows that scope
+      # and, with a blank status, narrows nothing. No order: Loam::Export batches
+      # with find_each, which forces its own.
+      scope = Customer.by_status(status)
+      progress = Loam::Progress.start(name: "Export customers", total: scope.count, key: KEY)
+
+      begin
+        # Policy- and encryption-aware, with CSV formula injection neutralized —
+        # the one way this app turns a relation into a CSV.
+        csv = Loam::Export.csv(scope, actor: actor)
+        progress.update_columns(result: { "csv" => csv, "filename" => filename(status), "status" => status })
+        progress.complete!
+      rescue StandardError => error
+        progress.fail!(error.message)
+      end
+    end
+  end
+
+  private
+
+  def filename(status)
+    "customers-#{status.presence || 'all'}-#{Date.current}.csv"
+  end
+end
