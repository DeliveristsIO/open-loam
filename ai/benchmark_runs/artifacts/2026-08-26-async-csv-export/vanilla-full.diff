@@ -0,0 +1,72 @@
+require "test_helper"
+require "csv"
+
+class CustomerExportJobTest < ActiveSupport::TestCase
+  setup do
+    @acme = organizations(:acme)
+    @alice = users(:alice)
+    @globex_secret = customers(:globex_secret)
+  end
+
+  test "exports every customer of the export's organization" do
+    export = create_export
+
+    CustomerExportJob.perform_now(export)
+    export.reload
+
+    assert export.completed?
+    assert export.completed_at.present?
+
+    rows = CSV.parse(export.csv_data)
+    assert_equal %w[name email status], rows.first
+    assert_equal [
+      [ "Acme Active", "active@acme.test", "active" ],
+      [ "Acme Inactive", "inactive@acme.test", "inactive" ]
+    ], rows.drop(1)
+  end
+
+  test "exports only the customers matching the status filter" do
+    export = create_export(status_filter: "inactive")
+
+    CustomerExportJob.perform_now(export)
+
+    rows = CSV.parse(export.reload.csv_data).drop(1)
+    assert_equal [ [ "Acme Inactive", "inactive@acme.test", "inactive" ] ], rows
+  end
+
+  test "never exports another organization's customers" do
+    export = create_export
+
+    CustomerExportJob.perform_now(export)
+    csv_data = export.reload.csv_data
+
+    assert_no_match @globex_secret.name, csv_data
+    assert_no_match @globex_secret.email, csv_data
+  end
+
+  test "runs without Current being set, taking the organization from the export" do
+    export = organizations(:globex).customer_exports.create!(user: users(:eve))
+
+    Current.user = nil
+    CustomerExportJob.perform_now(export)
+
+    rows = CSV.parse(export.reload.csv_data).drop(1)
+    assert_equal [ [ "Globex Secret", "secret@globex.test", "active" ] ], rows
+  end
+
+  test "marks the export failed and re-raises when generation blows up" do
+    export = create_export
+
+    export.organization.define_singleton_method(:customers) { raise "boom" }
+
+    assert_raises(RuntimeError) { CustomerExportJob.perform_now(export) }
+
+    assert export.reload.failed?
+    assert_nil export.csv_data
+  end
+
+  private
+    def create_export(status_filter: nil)
+      @acme.customer_exports.create!(user: @alice, status_filter: status_filter)
+    end
+end
