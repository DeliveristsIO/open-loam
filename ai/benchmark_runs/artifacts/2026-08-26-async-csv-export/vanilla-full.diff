+class CustomerExportsController < ApplicationController
+  # Exporting customers is a manager-only action, and the exports themselves are
+  # organization-owned, so they are always reached through
+  # `current_organization`.
+  before_action :require_manager
+
+  def index
+    @customer_exports = current_organization.customer_exports.ordered
+  end
+
+  def create
+    customer_export = current_organization.customer_exports.create!(
+      user: current_user,
+      status_filter: Customer.permitted_status(params[:status])
+    )
+
+    CustomerExportJob.perform_later(customer_export)
+
+    redirect_to customer_exports_path, notice: "Export started. It will be ready to download shortly."
+  end
+
+  def show
+    customer_export = current_organization.customer_exports.find(params[:id])
+
+    if customer_export.downloadable?
+      send_data customer_export.csv_data, filename: customer_export.filename, type: "text/csv"
+    else
+      redirect_to customer_exports_path, alert: "That export is not ready yet."
+    end
+  end
+end
