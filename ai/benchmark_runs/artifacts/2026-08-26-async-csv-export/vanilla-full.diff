+require "test_helper"
+
+class CustomerExportTest < ActiveSupport::TestCase
+  setup do
+    @acme = organizations(:acme)
+    @alice = users(:alice)
+  end
+
+  test "a new export starts out pending and is not downloadable" do
+    export = @acme.customer_exports.create!(user: @alice)
+
+    assert export.pending?
+    assert_not export.downloadable?
+  end
+
+  test "a completed export without data is not downloadable" do
+    export = @acme.customer_exports.create!(user: @alice, status: "completed")
+
+    assert_not export.downloadable?
+  end
+
+  test "a completed export with data is downloadable" do
+    export = @acme.customer_exports.create!(user: @alice, status: "completed", csv_data: "name,email,status\n")
+
+    assert export.downloadable?
+  end
+
+  test "an unknown status is rejected" do
+    export = @acme.customer_exports.new(user: @alice, status: "bogus")
+
+    assert_not export.valid?
+    assert_includes export.errors[:status], "is not included in the list"
+  end
+
+  test "a status filter must be a known customer status" do
+    assert @acme.customer_exports.new(user: @alice, status_filter: "active").valid?
+    assert @acme.customer_exports.new(user: @alice, status_filter: nil).valid?
+    assert_not @acme.customer_exports.new(user: @alice, status_filter: "bogus").valid?
+  end
+
+  test "the filename names the filter it was generated for" do
+    all = @acme.customer_exports.create!(user: @alice)
+    active = @acme.customer_exports.create!(user: @alice, status_filter: "active")
+
+    assert_match(/\Acustomers-all-\d{14}\.csv\z/, all.filename)
+    assert_match(/\Acustomers-active-\d{14}\.csv\z/, active.filename)
+  end
+end
