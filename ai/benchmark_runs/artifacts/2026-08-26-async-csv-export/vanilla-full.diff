diff --git a/app/jobs/customer_export_job.rb b/app/jobs/customer_export_job.rb
new file mode 100644
index 0000000..dd377c6
--- /dev/null
+++ b/app/jobs/customer_export_job.rb
@@ -0,0 +1,29 @@
+require "csv"
+
+# Generates the CSV for a CustomerExport outside the request cycle.
+#
+# `Current` is empty in a job, so the organization is never re-derived here: it
+# comes from the export record that was passed in, and the customers are
+# re-scoped through that organization.
+class CustomerExportJob < ApplicationJob
+  queue_as :default
+
+  HEADERS = %w[name email status].freeze
+
+  def perform(customer_export)
+    organization = customer_export.organization
+
+    csv = CSV.generate do |rows|
+      rows << HEADERS
+
+      organization.customers.by_status(customer_export.status_filter).ordered.each do |customer|
+        rows << [ customer.name, customer.email, customer.status ]
+      end
+    end
+
+    customer_export.update!(status: "completed", csv_data: csv, completed_at: Time.current)
+  rescue StandardError
+    customer_export.update!(status: "failed", completed_at: Time.current)
+    raise
+  end
+end
diff --git a/app/models/customer.rb b/app/models/customer.rb
index c5e96c0..c17f328 100644
--- a/app/models/customer.rb
+++ b/app/models/customer.rb
@@ -12,4 +12,11 @@ class Customer < ApplicationRecord
 
   scope :by_status, ->(status) { status.present? ? where(status: status) : all }
   scope :ordered, -> { order(:name) }
+
+  # Returns the given status only when it is one of the known statuses, so an
+  # unknown filter falls back to "all customers" instead of raising.
+  def self.permitted_status(status)
+    status = status.presence
+    status if statuses.key?(status)
+  end
 end
diff --git a/app/models/customer_export.rb b/app/models/customer_export.rb
new file mode 100644
index 0000000..e78d7ac
--- /dev/null
+++ b/app/models/customer_export.rb
@@ -0,0 +1,25 @@
+# A CSV export of an organization's customers, generated in the background.
+#
+# The export is organization-owned: it is always reached through
+# `current_organization.customer_exports`, and the CSV it produces only ever
+# contains customers of that same organization.
+class CustomerExport < ApplicationRecord
+  belongs_to :organization
+  belongs_to :user
+
+  STATUSES = %w[pending completed failed].freeze
+
+  enum :status, STATUSES.index_by(&:itself), validate: true
+
+  validates :status_filter, inclusion: { in: Customer::STATUSES }, allow_nil: true
+
+  scope :ordered, -> { order(created_at: :desc) }
+
+  def filename
+    "customers-#{status_filter || 'all'}-#{created_at.utc.strftime('%Y%m%d%H%M%S')}.csv"
+  end
+
+  def downloadable?
+    completed? && csv_data.present?
+  end
+end
