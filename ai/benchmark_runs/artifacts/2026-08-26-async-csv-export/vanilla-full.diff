--- /dev/null
+++ b/test/integration/customer_exports_test.rb
@@ -0,0 +1,184 @@
+require "test_helper"
+
+class CustomerExportsTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    @alice = users(:alice)
+    @bob = users(:bob)
+    @eve = users(:eve)
+
+    @acme = organizations(:acme)
+    @globex = organizations(:globex)
+
+    @globex_secret = customers(:globex_secret)
+  end
+
+  test "requires authentication to start an export" do
+    assert_no_difference -> { CustomerExport.count } do
+      post customer_exports_path
+    end
+
+    assert_redirected_to new_session_path
+  end
+
+  test "requires authentication to list exports" do
+    get customer_exports_path
+
+    assert_redirected_to new_session_path
+  end
+
+  test "alice, an ACME manager, starts an export and it is enqueued" do
+    sign_in_as @alice
+
+    assert_difference -> { CustomerExport.count }, 1 do
+      post customer_exports_path
+    end
+
+    export = CustomerExport.order(:id).last
+    assert_equal @acme, export.organization
+    assert_equal @alice, export.user
+    assert_nil export.status_filter
+    assert export.pending?
+
+    assert_redirected_to customer_exports_path
+    assert_enqueued_with job: CustomerExportJob, args: [ export ]
+  end
+
+  test "an export records the selected status filter" do
+    sign_in_as @alice
+    post customer_exports_path(status: "inactive")
+
+    assert_equal "inactive", CustomerExport.order(:id).last.status_filter
+  end
+
+  test "an unknown status filter exports every customer of the organization" do
+    sign_in_as @alice
+    post customer_exports_path(status: "bogus")
+
+    assert_nil CustomerExport.order(:id).last.status_filter
+  end
+
+  test "bob, an ACME member, may not start an export" do
+    sign_in_as @bob
+
+    assert_no_difference -> { CustomerExport.count } do
+      assert_no_enqueued_jobs only: CustomerExportJob do
+        post customer_exports_path
+      end
+    end
+
+    assert_redirected_to customers_path
+    assert_equal "You are not allowed to do that.", flash[:alert]
+  end
+
+  test "bob, an ACME member, may not list exports" do
+    sign_in_as @bob
+    get customer_exports_path
+
+    assert_redirected_to customers_path
+    assert_equal "You are not allowed to do that.", flash[:alert]
+  end
+
+  test "bob, an ACME member, may not download an export" do
+    export = completed_export(@acme, @alice)
+
+    sign_in_as @bob
+    get customer_export_path(export)
+
+    assert_redirected_to customers_path
+    assert_equal "You are not allowed to do that.", flash[:alert]
+  end
+
+  test "members are not offered the export button" do
+    sign_in_as @bob
+    get customers_path
+
+    assert_response :success
+    assert_select "form[action=?]", customer_exports_path, false
+  end
+
+  test "managers are offered the export button carrying the current filter" do
+    sign_in_as @alice
+    get customers_path(status: "active")
+
+    assert_response :success
+    assert_select "form[action=?]", customer_exports_path(status: "active")
+  end
+
+  test "alice downloads a completed export as CSV" do
+    sign_in_as @alice
+
+    perform_enqueued_jobs do
+      post customer_exports_path(status: "active")
+    end
+
+    export = CustomerExport.order(:id).last
+    assert export.completed?
+
+    get customer_export_path(export)
+
+    assert_response :success
+    assert_equal "text/csv", response.media_type
+    assert_match "attachment", response.headers["Content-Disposition"]
+    assert_match export.filename, response.headers["Content-Disposition"]
+
+    assert_equal <<~CSV, response.body
+      name,email,status
+      Acme Active,active@acme.test,active
+    CSV
+  end
+
+  test "a downloaded export never contains another organization's customers" do
+    sign_in_as @alice
+
+    perform_enqueued_jobs do
+      post customer_exports_path
+    end
+
+    get customer_export_path(CustomerExport.order(:id).last)
+
+    assert_response :success
+    assert_no_match @globex_secret.name, response.body
+    assert_no_match @globex_secret.email, response.body
+  end
+
+  test "an export that is still pending is not downloadable" do
+    export = @acme.customer_exports.create!(user: @alice)
+
+    sign_in_as @alice
+    get customer_export_path(export)
+
+    assert_redirected_to customer_exports_path
+    assert_equal "That export is not ready yet.", flash[:alert]
+  end
+
+  test "eve, a GLOBEX manager, cannot reach an ACME export" do
+    export = completed_export(@acme, @alice)
+
+    sign_in_as @eve
+    get customer_export_path(export)
+
+    assert_response :not_found
+    assert_no_match export.csv_data, response.body
+  end
+
+  test "the exports list only shows the current organization's exports" do
+    acme_export = completed_export(@acme, @alice)
+    globex_export = completed_export(@globex, @eve)
+
+    sign_in_as @alice
+    get customer_exports_path
+
+    assert_response :success
+    assert_select "##{dom_id(acme_export)}"
+    assert_select "##{dom_id(globex_export)}", false
+  end
+
+  private
+    def completed_export(organization, user, status_filter: nil)
+      export = organization.customer_exports.create!(user: user, status_filter: status_filter)
+      CustomerExportJob.perform_now(export)
+      export.reload
+    end
+end
