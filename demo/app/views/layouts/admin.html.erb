<!DOCTYPE html>
<html>
  <head>
    <title>Admin</title>
    <%= csrf_meta_tags %>
    <style>
      body { font-family: system-ui, sans-serif; margin: 2rem; }
      table { border-collapse: collapse; }
      th, td { border: 1px solid #ccc; padding: 0.4rem 0.8rem; text-align: left; }
      nav { margin-bottom: 1.5rem; }
      nav a { margin-right: 1rem; }
      nav form { display: inline; }
      .context { color: #555; font-size: 0.9rem; margin-bottom: 1rem; }
    </style>
  </head>
  <body>
    <% if defined?(current_tenant) && current_tenant %>
      <div class="context">
        Tenant: <strong><%= current_tenant.name %></strong> ·
        User: <strong><%= current_actor&.name %></strong> ·
        <%= button_to "Sign out", admin_session_path, method: :delete, form: { style: "display:inline" } %>
      </div>
      <nav>
        <%= link_to "Dashboard", admin_root_path %>
        <%= link_to "Notifications (#{unread_notification_count})", admin_notifications_path %>
        <%= link_to "API tokens", admin_api_tokens_path %>
        <%= link_to "Security", admin_mfa_path %>
        <%= link_to "Approvals (#{pending_approval_count})", admin_pending_actions_path %>
        <%= link_to "Settings", admin_configs_path %>
        <%= link_to "Features", admin_features_path %>
        <%# Gated by a flag: the link only appears for tenants with the capability on. %>
        <% if feature_on?(:beta_dashboard) %>
          <%= link_to "Beta", admin_beta_dashboard_path %>
        <% end %>
        <%= form_with url: admin_search_path, method: :get, class: "search" do %>
          <%= text_field_tag :q, params[:q], placeholder: "Search" %>
        <% end %>
      </nav>
    <% end %>
    <%= yield %>
  </body>
</html>
