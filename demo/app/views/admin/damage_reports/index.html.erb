<%# One policy for the whole table: readable? keys off the actor's ROLE, not the
    row, so building it per record would only add a membership query per row. %>
<% policy = OpenLoam::Policy.for_model(DamageReport, current_actor) %>

<h1>Damage reports</h1>

<p>
  <%= link_to "New damage report", new_polymorphic_path([:admin, DamageReport]) %>
  <%= link_to "Deleted damage reports", polymorphic_path([:deleted, :admin, DamageReport]) %>
</p>

<%= form_with url: [:admin, DamageReport], method: :get do |f| %>
  <%= text_field_tag :q, params[:q], placeholder: "Filter damage reports" %>
  <%= f.submit "Filter" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <% if policy.readable?(:equipment_id) %><th>Equipment</th><% end %>
      <% if policy.readable?(:description) %><th>Description</th><% end %>
      <% if policy.readable?(:approved) %><th>Approved</th><% end %>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |record| %>
      <tr>
        <td><%= record.id %></td>
        <% if policy.readable?(:equipment_id) %><td><%= record.equipment_id %></td><% end %>
        <% if policy.readable?(:description) %><td><%= record.description %></td><% end %>
        <% if policy.readable?(:approved) %><td><%= record.approved %></td><% end %>
        <td>
          <%= link_to "Show", [:admin, record] %>
          <%= link_to "Edit", edit_polymorphic_path([:admin, record]) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%# Page links carry the filter, or page 2 would quietly drop it. %>
<p>
  <% if @page > 1 %>
    <%= link_to "← Previous", polymorphic_path([:admin, DamageReport], page: @page - 1, q: params[:q]) %>
  <% end %>
  Page <%= @page %>
  <% if @has_next %>
    <%= link_to "Next →", polymorphic_path([:admin, DamageReport], page: @page + 1, q: params[:q]) %>
  <% end %>
</p>
