<h1>Damage reports</h1>

<p><%= link_to "New damage report", new_polymorphic_path([:admin, DamageReport]) %></p>

<%= form_with url: [:admin, DamageReport], method: :get do |f| %>
  <%= text_field_tag :q, params[:q], placeholder: "Filter damage reports" %>
  <%= f.submit "Filter" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Equipment</th>
      <th>Description</th>
      <th>Approved</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |record| %>
      <tr>
        <td><%= record.id %></td>
        <td><%= record.equipment_id %></td>
        <td><%= record.description %></td>
        <td><%= record.approved %></td>
        <td>
          <%= link_to "Show", [:admin, record] %>
          <%= link_to "Edit", edit_polymorphic_path([:admin, record]) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%# Page links carry the filter, or page 2 would quietly drop it. %>
<p>
  <% if @page > 1 %>
    <%= link_to "← Previous", polymorphic_path([:admin, DamageReport], page: @page - 1, q: params[:q]) %>
  <% end %>
  Page <%= @page %>
  <% if @has_next %>
    <%= link_to "Next →", polymorphic_path([:admin, DamageReport], page: @page + 1, q: params[:q]) %>
  <% end %>
</p>
