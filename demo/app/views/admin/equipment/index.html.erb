<h1>Equipment</h1>

<% if @index_partial %>
  <p style="color:#b00">Results may be incomplete — the custom-field index is rebuilding in the background.</p>
<% end %>

<p>
  <%= link_to "New equipment", new_polymorphic_path([:admin, Equipment]) %>
  <%= link_to "Deleted equipment", polymorphic_path([:deleted, :admin, Equipment]) %>
  <% if current_role == :manager %>
    <%= link_to "Export CSV", export_admin_equipment_index_path(q: params[:q], perspective_id: params[:perspective_id]) %>
    <%= link_to "Import CSV", new_admin_import_path(entity_type: "Equipment") %>
  <% end %>
</p>

<%# Saved views (Loam::Perspectives): pick one to apply, or save the current one. %>
<% if @perspectives.any? %>
  <%= form_with url: [:admin, Equipment], method: :get, class: "perspective-picker" do %>
    <%= select_tag :perspective_id,
          options_for_select([["All equipment (no saved view)", "none"]] + @perspectives.map { |p| [p.name, p.id] }, @perspective&.id),
          onchange: "this.form.submit()" %>
    <%= link_to "Manage views", admin_perspectives_path(entity_type: "Equipment") %>
  <% end %>
<% else %>
  <p><%= link_to "Manage saved views", admin_perspectives_path(entity_type: "Equipment") %></p>
<% end %>

<%= form_with url: [:admin, Equipment], method: :get do |f| %>
  <%= text_field_tag :q, params[:q], placeholder: "Filter equipment" %>
  <%= f.submit "Filter" %>
<% end %>

<%# Save the current filter/sort as a new private view. %>
<%= form_with url: admin_perspectives_path, method: :post, class: "save-view" do %>
  <%= hidden_field_tag :entity_type, "Equipment" %>
  <%= hidden_field_tag :q, params[:q] %>
  <%= text_field_tag :name, nil, placeholder: "Name this view" %>
  <%= submit_tag "Save current view" %>
<% end %>

<%# Bulk actions on selected rows (Loam::Bulk). Zero selection = no-op. Each
    action is policy-checked per record server-side. %>
<%= form_with url: bulk_admin_equipment_index_path, method: :post do %>
  <p>
    <%= select_tag :bulk_action, options_for_select([["Delete selected", "soft_delete"], ["Set status of selected", "set_status"], ["Export selected", "export"]]) %>
    <%= text_field_tag :value, nil, placeholder: "status (for Set status)" %>
    <%= submit_tag "Apply to selected", data: { turbo_confirm: "Apply to the selected rows?" } %>
  </p>

  <table>
    <thead>
      <tr>
        <th><input type="checkbox" onclick="document.querySelectorAll('.bulk-select').forEach(function(c){c.checked=this.checked}.bind(this))"></th>
        <th>ID</th>
        <th>Name</th>
        <th>Daily rate</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @records.each do |record| %>
        <tr>
          <td><%= check_box_tag "ids[]", record.id, false, class: "bulk-select", id: "sel-#{record.id}" %></td>
          <td><%= record.id %></td>
          <td><%= record.name %></td>
          <td><%= record.daily_rate %></td>
          <td><%= record.status %></td>
          <td>
            <%= link_to "Show", [:admin, record] %>
            <%= link_to "Edit", edit_polymorphic_path([:admin, record]) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%# Page links carry the filter, or page 2 would quietly drop it. %>
<p>
  <% if @page > 1 %>
    <%= link_to "← Previous", polymorphic_path([:admin, Equipment], page: @page - 1, q: params[:q]) %>
  <% end %>
  Page <%= @page %>
  <% if @has_next %>
    <%= link_to "Next →", polymorphic_path([:admin, Equipment], page: @page + 1, q: params[:q]) %>
  <% end %>
</p>
