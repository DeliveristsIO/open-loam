<h1><%= Equipment.model_name.human(count: 2) %></h1>

<% if @index_partial %>
  <p style="color:#b00"><%= t("loam.index.incomplete") %></p>
<% end %>

<p>
  <%= link_to t("loam.actions.new", name: Equipment.model_name.human), new_polymorphic_path([:admin, Equipment]) %>
  <%= link_to t("loam.actions.deleted", name: Equipment.model_name.human(count: 2)), polymorphic_path([:deleted, :admin, Equipment]) %>
  <% if current_role == :manager %>
    <%= link_to t("loam.actions.export_csv"), export_admin_equipment_index_path(**current_index_params) %>
    <%= link_to t("loam.actions.import_csv"), new_admin_import_path(entity_type: "Equipment") %>
  <% end %>
</p>

<%# Saved views (Loam::Perspectives): pick one to apply, or save the current one. %>
<% if @perspectives.any? %>
  <%= form_with url: [:admin, Equipment], method: :get, class: "perspective-picker" do %>
    <%= select_tag :perspective_id,
          options_for_select([[t("loam.views.all", name: Equipment.model_name.human(count: 2)), "none"]] + @perspectives.map { |p| [p.name, p.id] }, @perspective&.id),
          onchange: "this.form.submit()" %>
    <%= link_to t("loam.views.manage"), admin_perspectives_path(entity_type: "Equipment") %>
  <% end %>
<% else %>
  <p><%= link_to t("loam.views.manage_saved"), admin_perspectives_path(entity_type: "Equipment") %></p>
<% end %>

<%= form_with url: [:admin, Equipment], method: :get do |f| %>
  <%= text_field_tag :q, params[:q], placeholder: t("loam.views.filter_placeholder", name: Equipment.model_name.human(count: 2)) %>
  <%= f.submit t("loam.actions.filter") %>
<% end %>

<%# Save the current filter/sort as a new private view. %>
<%= form_with url: admin_perspectives_path, method: :post, class: "save-view" do %>
  <%= hidden_field_tag :entity_type, "Equipment" %>
  <%= hidden_field_tag :q, params[:q] %>
  <%= text_field_tag :name, nil, placeholder: t("loam.views.name_placeholder") %>
  <%= submit_tag t("loam.views.save_current") %>
<% end %>

<%# Bulk actions on selected rows (Loam::Bulk). Zero selection = no-op. Each
    action is policy-checked per record server-side. (The "set status" action is
    demo-specific; its labels stay literal.) %>
<%= form_with url: bulk_admin_equipment_index_path, method: :post do %>
  <p>
    <%= select_tag :bulk_action, options_for_select([[t("loam.bulk.delete_selected"), "soft_delete"], ["Set status of selected", "set_status"], [t("loam.bulk.export_selected"), "export"]]) %>
    <%= text_field_tag :value, nil, placeholder: "status (for Set status)" %>
    <%= submit_tag t("loam.bulk.apply"), data: { turbo_confirm: t("loam.bulk.confirm") } %>
  </p>

  <table>
    <thead>
      <tr>
        <th><input type="checkbox" onclick="document.querySelectorAll('.bulk-select').forEach(function(c){c.checked=this.checked}.bind(this))"></th>
        <th><%= t("loam.labels.id") %></th>
        <th><%= sort_link("name", Equipment.human_attribute_name("name")) %></th>
        <th><%= sort_link("daily_rate", Equipment.human_attribute_name("daily_rate")) %></th>
        <th><%= sort_link("status", Equipment.human_attribute_name("status")) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @records.each do |record| %>
        <tr>
          <td><%= check_box_tag "ids[]", record.id, false, class: "bulk-select", id: "sel-#{record.id}" %></td>
          <td><%= record.id %></td>
          <td><%= record.name %></td>
          <td><%= record.daily_rate %></td>
          <td><%= record.status %></td>
          <td>
            <%= link_to t("loam.actions.show"), [:admin, record] %>
            <%= link_to t("loam.actions.edit"), edit_polymorphic_path([:admin, record]) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%# Page links carry the full filter state, or page 2 would quietly drop it. %>
<p>
  <% if @page > 1 %>
    <%= link_to t("loam.pagination.previous"), polymorphic_path([:admin, Equipment], **current_index_params, page: @page - 1) %>
  <% end %>
  <%= t("loam.pagination.page", page: @page) %>
  <% if @has_next %>
    <%= link_to t("loam.pagination.next"), polymorphic_path([:admin, Equipment], **current_index_params, page: @page + 1) %>
  <% end %>
</p>
