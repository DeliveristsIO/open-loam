<% policy = Loam::Policy.for(@record) %>

<h1>Equipment #<%= @record.id %></h1>

<p><strong>Name:</strong> <%= @record.name %></p>
<p><strong>Daily rate:</strong> <%= @record.daily_rate %></p>
<p><strong>Status:</strong> <%= @record.status %></p>

<%= render "loam/custom_fields/fields", record: @record, policy: policy, mode: :show %>

<%# Computed cross-module blocks (Loam::Enrichers) — no section when none registered. %>
<% enrichments = Loam::Enrichers.enrich(@record) %>
<% if enrichments.any? %>
  <h2>Enrichments</h2>
  <dl>
    <% enrichments.each do |key, value| %>
      <dt><strong><%= key.humanize %></strong></dt>
      <dd><%= value %></dd>
    <% end %>
  </dl>
<% end %>

<p>
  <%= link_to "Edit", edit_polymorphic_path([:admin, @record]) %>
  <%# Delete soft-deletes: the record moves to the recycle bin, not oblivion. %>
  <%= button_to "Delete", [:admin, @record], method: :delete if policy.destroy? %>
  <%= link_to "Back", [:admin, Equipment] %>
</p>

<fieldset>
  <legend>Propose a price change (staged for approval)</legend>
  <%# Simulates an AI agent under confirm-mode: this stages the change rather
      than applying it — a manager approves it under Approvals. %>
  <%= form_with url: propose_price_admin_equipment_path(@record), method: :post do %>
    <%= number_field_tag :daily_rate, @record.daily_rate, step: :any %>
    <%= submit_tag "Propose" %>
  <% end %>
</fieldset>

<%= render "loam/attachments/attachments", record: @record %>

<%= render "loam/comments/comments", record: @record %>
