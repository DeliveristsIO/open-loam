<% policy = OpenLoam::Policy.for(@record) %>

<h1>Customer #<%= @record.id %></h1>

<% if policy.readable?(:name) %><p><strong>Name:</strong> <%= @record.name %></p><% end %>
<% if policy.readable?(:email) %><p><strong>Email:</strong> <%= @record.email %></p><% end %>
<% if policy.readable?(:tax_id) %><p><strong>Tax:</strong> <%= @record.tax_id %></p><% end %>

<%= render "open_loam/custom_fields/fields", record: @record, policy: policy, mode: :show %>

<p>
  <%= link_to "Edit", edit_polymorphic_path([:admin, @record]) %>
  <%# Delete soft-deletes: the record moves to the recycle bin, not oblivion. %>
  <%= button_to "Delete", [:admin, @record], method: :delete if policy.destroy? %>
  <%= link_to "Back", [:admin, Customer] %>
</p>

<%= render "open_loam/attachments/attachments", record: @record %>

<%= render "open_loam/comments/comments", record: @record %>
