<%# One policy for the whole table: readable? keys off the actor's ROLE, not the
    row, so building it per record would only add a membership query per row. %>
<% policy = OpenLoam::Policy.for_model(Customer, current_actor) %>

<h1>Customers</h1>

<p>
  <%= link_to "New customer", new_polymorphic_path([:admin, Customer]) %>
  <%= link_to "Deleted customers", polymorphic_path([:deleted, :admin, Customer]) %>
</p>

<%= form_with url: [:admin, Customer], method: :get do |f| %>
  <%= text_field_tag :q, params[:q], placeholder: "Filter customers" %>
  <%= f.submit "Filter" %>
<% end %>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <% if policy.readable?(:name) %><th>Name</th><% end %>
      <% if policy.readable?(:email) %><th>Email</th><% end %>
      <% if policy.readable?(:tax_id) %><th>Tax</th><% end %>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @records.each do |record| %>
      <tr>
        <td><%= record.id %></td>
        <% if policy.readable?(:name) %><td><%= record.name %></td><% end %>
        <% if policy.readable?(:email) %><td><%= record.email %></td><% end %>
        <% if policy.readable?(:tax_id) %><td><%= record.tax_id %></td><% end %>
        <td>
          <%= link_to "Show", [:admin, record] %>
          <%= link_to "Edit", edit_polymorphic_path([:admin, record]) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%# Page links carry the filter, or page 2 would quietly drop it. %>
<p>
  <% if @page > 1 %>
    <%= link_to "← Previous", polymorphic_path([:admin, Customer], page: @page - 1, q: params[:q]) %>
  <% end %>
  Page <%= @page %>
  <% if @has_next %>
    <%= link_to "Next →", polymorphic_path([:admin, Customer], page: @page + 1, q: params[:q]) %>
  <% end %>
</p>
