<h1><%= Lead.model_name.human(count: 2) %></h1>

<% if @index_partial %>
  <p style="color:#b00"><%= t("open_loam.index.incomplete") %></p>
<% end %>

<p>
  <%= link_to t("open_loam.actions.new", name: Lead.model_name.human), new_polymorphic_path([:admin, Lead]) %>
  <%= link_to t("open_loam.actions.deleted", name: Lead.model_name.human(count: 2)), polymorphic_path([:deleted, :admin, Lead]) %>
  <% if current_role == :manager %>
    <%= link_to t("open_loam.actions.export_csv"), url_for(action: :export, **current_index_params) %>
    <%= link_to t("open_loam.actions.import_csv"), new_admin_import_path(entity_type: "Lead") %>
  <% end %>
</p>

<%# Saved views (OpenLoam::Perspectives): pick one to apply, or save the current one. %>
<% if @perspectives.any? %>
  <%= form_with url: [:admin, Lead], method: :get do %>
    <%= select_tag :perspective_id,
          options_for_select([[t("open_loam.views.all", name: Lead.model_name.human(count: 2)), "none"]] + @perspectives.map { |p| [p.name, p.id] }, @perspective&.id),
          onchange: "this.form.submit()" %>
    <%= link_to t("open_loam.views.manage"), admin_perspectives_path(entity_type: "Lead") %>
  <% end %>
<% else %>
  <p><%= link_to t("open_loam.views.manage_saved"), admin_perspectives_path(entity_type: "Lead") %></p>
<% end %>

<%= form_with url: admin_perspectives_path, method: :post do %>
  <%= hidden_field_tag :entity_type, "Lead" %>
  <%= hidden_field_tag :q, params[:q] %>
  <%= text_field_tag :name, nil, placeholder: t("open_loam.views.name_placeholder") %>
  <%= submit_tag t("open_loam.views.save_current") %>
<% end %>

<%= form_with url: [:admin, Lead], method: :get do |f| %>
  <%= text_field_tag :q, params[:q], placeholder: t("open_loam.views.filter_placeholder", name: Lead.model_name.human(count: 2)) %>
  <%= f.submit t("open_loam.actions.filter") %>
<% end %>

<%# Bulk actions on selected rows (OpenLoam::Bulk). Zero selection = no-op; each
    action is policy-checked per record server-side. %>
<%= form_with url: url_for(action: :bulk), method: :post do %>
  <p>
    <%= select_tag :bulk_action, options_for_select([[t("open_loam.bulk.delete_selected"), "soft_delete"], [t("open_loam.bulk.set_field"), "set_field"], [t("open_loam.bulk.export_selected"), "export"]]) %>
    <%= select_tag :field, options_for_select(%i[company_id source value state]) %>
    <%= text_field_tag :value, nil, placeholder: t("open_loam.bulk.new_value") %>
    <%= submit_tag t("open_loam.bulk.apply"), data: { turbo_confirm: t("open_loam.bulk.confirm") } %>
  </p>

  <table>
    <thead>
      <tr>
        <th><input type="checkbox" onclick="document.querySelectorAll('.bulk-select').forEach(function(c){c.checked=this.checked}.bind(this))"></th>
        <th><%= t("open_loam.labels.id") %></th>
        <th><%= sort_link("company_id", Lead.human_attribute_name("company_id")) %></th>
        <th><%= sort_link("source", Lead.human_attribute_name("source")) %></th>
        <th><%= sort_link("value", Lead.human_attribute_name("value")) %></th>
        <th><%= sort_link("state", Lead.human_attribute_name("state")) %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @records.each do |record| %>
        <tr>
          <td><%= check_box_tag "ids[]", record.id, false, class: "bulk-select" %></td>
          <td><%= record.id %></td>
          <td><%= record.company_id %></td>
          <td><%= record.source %></td>
          <td><%= record.value %></td>
          <td><%= record.state %></td>
          <td>
            <%= link_to t("open_loam.actions.show"), [:admin, record] %>
            <%= link_to t("open_loam.actions.edit"), edit_polymorphic_path([:admin, record]) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%# Page links carry the full filter state, or page 2 would quietly drop it. %>
<p>
  <% if @page > 1 %>
    <%= link_to t("open_loam.pagination.previous"), polymorphic_path([:admin, Lead], **current_index_params, page: @page - 1) %>
  <% end %>
  <%= t("open_loam.pagination.page", page: @page) %>
  <% if @has_next %>
    <%= link_to t("open_loam.pagination.next"), polymorphic_path([:admin, Lead], **current_index_params, page: @page + 1) %>
  <% end %>
</p>
