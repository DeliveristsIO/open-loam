<% policy = OpenLoam::Policy.for(@record) %>

<h1><%= t("open_loam.actions.show_title", name: Lead.model_name.human, id: @record.id) %></h1>

<% if policy.readable?(:company_id) %>
<p><strong><%= Lead.human_attribute_name("company_id") %>:</strong> <%= @record.company_id %></p>
<% end %>
<% if policy.readable?(:source) %>
<p><strong><%= Lead.human_attribute_name("source") %>:</strong> <%= @record.source %></p>
<% end %>
<% if policy.readable?(:value) %>
<p><strong><%= Lead.human_attribute_name("value") %>:</strong> <%= @record.value %></p>
<% end %>
<% if policy.readable?(:state) %>
<p><strong><%= Lead.human_attribute_name("state") %>:</strong> <%= @record.state %></p>
<% end %>

<%= render "open_loam/custom_fields/fields", record: @record, policy: policy, mode: :show %>

<%# Computed cross-module blocks (OpenLoam::Enrichers) — no section when none registered. %>
<% enrichments = OpenLoam::Enrichers.enrich(@record) %>
<% if enrichments.any? %>
  <h2><%= t("open_loam.labels.enrichments") %></h2>
  <dl>
    <% enrichments.each do |key, value| %>
      <dt><strong><%= key.humanize %></strong></dt>
      <dd><%= value %></dd>
    <% end %>
  </dl>
<% end %>

<p>
  <%= link_to t("open_loam.actions.edit"), edit_polymorphic_path([:admin, @record]) %>
  <%= link_to "History", admin_history_path(type: @record.class.name, record_id: @record.id) %>
  <% if @record.class.respond_to?(:open_loam_translatable_attributes) && @record.class.open_loam_translatable_attributes.any? && current_role == :manager %>
    <%= link_to t("open_loam.actions.translations"), admin_translations_path(translatable_type: @record.class.name, translatable_id: @record.id) %>
  <% end %>
  <%# Delete soft-deletes: the record moves to the recycle bin, not oblivion. %>
  <%= button_to t("open_loam.actions.destroy"), [:admin, @record], method: :delete if policy.destroy? %>
  <%= link_to t("open_loam.actions.back"), [:admin, Lead] %>
</p>

<%= render "open_loam/attachments/attachments", record: @record %>

<%= render "open_loam/comments/comments", record: @record %>
